# URL de la API de Laravel (solo la usa el servidor de Next). Sin ella, Brunito usa los datos de demo de src/data/demo.json.
LARAVEL_API_URL=http://127.0.0.1:8000/api
# Muestra el aviso de "propiedades de demostración" en el pie.
NEXT_PUBLIC_DEMO=1
# Clave compartida con Laravel (SITE_PROXY_KEY en backend/.env): así los límites se cuentan por visitante.
SITE_PROXY_KEY=
